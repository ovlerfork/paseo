From: Ovler <44089074+Ovler-Young@users.noreply.github.com>
Date: Mon, 14 Sep 2026 15:12:34 +0000
Subject: [PATCH] fix(docker): run mod start hooks


diff --git a/docker/base/rootfs/usr/local/bin/paseo-docker-entrypoint b/docker/base/rootfs/usr/local/bin/paseo-docker-entrypoint
index 7866a73..b75e777 100644
--- a/docker/base/rootfs/usr/local/bin/paseo-docker-entrypoint
+++ b/docker/base/rootfs/usr/local/bin/paseo-docker-entrypoint
@@ -91,6 +91,23 @@ apply_docker_mods() {
   /usr/local/bin/docker-mods
 }
 
+start_mod_services() {
+  shopt -s nullglob
+
+  local hook runtime_user
+  runtime_user="${PASEO_RUNTIME_USER:-paseo}"
+  for hook in /etc/paseo-mods/*/start; do
+    [[ -f "$hook" ]] || continue
+    chmod +x "$hook" 2>/dev/null || true
+    echo "[mods] starting service hook: ${hook}"
+    if [[ "$(id -u)" == "0" && "$runtime_user" == "paseo" ]]; then
+      gosu paseo bash "$hook" &
+    else
+      bash "$hook" &
+    fi
+  done
+}
+
 start_sshd() {
   case "${PASEO_SSH_ENABLED:-false}" in
     true | 1 | yes) ;;
@@ -132,6 +149,7 @@ start_sshd() {
 }
 
 apply_docker_mods
+start_mod_services
 start_sshd
 
 if [[ "$#" -gt 0 ]]; then
diff --git a/docker/mods/devspace/root-layer/etc/paseo-mods/devspace/start b/docker/mods/devspace/root-layer/etc/paseo-mods/devspace/start
new file mode 100755
index 0000000..0bd60d5
--- /dev/null
+++ b/docker/mods/devspace/root-layer/etc/paseo-mods/devspace/start
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+case "${DEVSPACE_ENABLED:-true}" in
+  true | 1 | yes) ;;
+  false | 0 | no)
+    echo "[mod:devspace] DEVSPACE_ENABLED=false; not starting."
+    exit 0
+    ;;
+  *)
+    echo "[mod:devspace] ERROR: unsupported DEVSPACE_ENABLED=${DEVSPACE_ENABLED}; expected true or false." >&2
+    exit 1
+    ;;
+esac
+
+if ! command -v devspace >/dev/null 2>&1; then
+  echo "[mod:devspace] ERROR: devspace is not on PATH; cannot start." >&2
+  exit 1
+fi
+
+state_dir="${HOME:-/home/paseo}/.devspace"
+if [[ ! -f "${state_dir}/auth.json" && -z "${DEVSPACE_OAUTH_OWNER_TOKEN:-}" ]]; then
+  echo "[mod:devspace] DevSpace is not initialized: ${state_dir}/auth.json is missing and DEVSPACE_OAUTH_OWNER_TOKEN is unset."
+  echo "[mod:devspace] Run 'devspace init' as the runtime user, then restart the container."
+  exit 0
+fi
+
+echo "[mod:devspace] starting devspace serve"
+exec devspace serve
diff --git a/docs/docker.md b/docs/docker.md
index 335433a..74c51f1 100644
--- a/docs/docker.md
+++ b/docs/docker.md
@@ -136,6 +136,13 @@ daemon. A configured mod failure stops startup by default so missing agent CLIs
 do not go unnoticed. Set `DOCKER_MODS_STRICT=false` to log mod failures and keep
 starting the daemon.
 
+Mod images may also carry a `start` hook at `/etc/paseo-mods/<name>/start`. The
+entrypoint runs each start hook in the background on every container start, as
+the runtime user, and never waits for it, so a mod service can come up
+alongside the daemon without blocking it. A start hook should exec a
+long-running process and exit 0 when the service is not configured or not
+wanted; a failing start hook is logged and does not stop the daemon.
+
 Native provider mods:
 
 | Mod tag       | Package                           | Binary     |
