diff --git a/packages/app/src/screens/workspace/workspace-tab-wheel.test.ts b/packages/app/src/screens/workspace/workspace-tab-wheel.test.ts
new file mode 100644
index 00000000..ccd22984
--- /dev/null
+++ b/packages/app/src/screens/workspace/workspace-tab-wheel.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, it } from "vitest";
+import {
+  TAB_WHEEL_COOLDOWN_MS,
+  createTabWheelState,
+  resolveWheelTabTarget,
+} from "./workspace-tab-wheel";
+
+const tabIds = ["a", "b", "c"];
+
+describe("resolveWheelTabTarget", () => {
+  it("moves to the next tab on downward wheel and previous on upward", () => {
+    const state = createTabWheelState();
+    expect(
+      resolveWheelTabTarget({ state, deltaX: 0, deltaY: 100, now: 1000, tabIds, activeTabId: "b" }),
+    ).toBe("c");
+    expect(
+      resolveWheelTabTarget({
+        state,
+        deltaX: 0,
+        deltaY: -100,
+        now: 2000,
+        tabIds,
+        activeTabId: "b",
+      }),
+    ).toBe("a");
+  });
+
+  it("does not wrap past the ends", () => {
+    const state = createTabWheelState();
+    expect(
+      resolveWheelTabTarget({ state, deltaX: 0, deltaY: 100, now: 1000, tabIds, activeTabId: "c" }),
+    ).toBeNull();
+    expect(
+      resolveWheelTabTarget({
+        state,
+        deltaX: 0,
+        deltaY: -100,
+        now: 2000,
+        tabIds,
+        activeTabId: "a",
+      }),
+    ).toBeNull();
+  });
+
+  it("accumulates small trackpad deltas before switching", () => {
+    const state = createTabWheelState();
+    const step = (now: number) =>
+      resolveWheelTabTarget({ state, deltaX: 0, deltaY: 15, now, tabIds, activeTabId: "a" });
+    expect(step(1000)).toBeNull();
+    expect(step(1010)).toBeNull();
+    expect(step(1020)).toBe("b");
+  });
+
+  it("ignores events inside the cooldown", () => {
+    const state = createTabWheelState();
+    const input = { state, deltaX: 0, deltaY: 100, tabIds, activeTabId: "a" };
+    expect(resolveWheelTabTarget({ ...input, now: 1000 })).toBe("b");
+    expect(resolveWheelTabTarget({ ...input, now: 1000 + TAB_WHEEL_COOLDOWN_MS - 1 })).toBeNull();
+  });
+
+  it("uses horizontal delta when it dominates", () => {
+    const state = createTabWheelState();
+    expect(
+      resolveWheelTabTarget({ state, deltaX: -80, deltaY: 5, now: 1000, tabIds, activeTabId: "b" }),
+    ).toBe("a");
+  });
+
+  it("does nothing with fewer than two tabs", () => {
+    const state = createTabWheelState();
+    expect(
+      resolveWheelTabTarget({
+        state,
+        deltaX: 0,
+        deltaY: 100,
+        now: 1000,
+        tabIds: ["a"],
+        activeTabId: "a",
+      }),
+    ).toBeNull();
+  });
+});
diff --git a/packages/app/src/screens/workspace/workspace-tab-wheel.ts b/packages/app/src/screens/workspace/workspace-tab-wheel.ts
new file mode 100644
index 00000000..d572b8c4
--- /dev/null
+++ b/packages/app/src/screens/workspace/workspace-tab-wheel.ts
@@ -0,0 +1,47 @@
+// Wheel-to-tab switching for the desktop tab row. Trackpads emit many small deltas per gesture,
+// so deltas accumulate until they cross a threshold and a cooldown keeps one flick from skipping
+// across several tabs.
+export const TAB_WHEEL_DELTA_THRESHOLD = 40;
+export const TAB_WHEEL_COOLDOWN_MS = 150;
+
+export interface TabWheelState {
+  accumulated: number;
+  lastSwitchAt: number;
+}
+
+export function createTabWheelState(): TabWheelState {
+  return { accumulated: 0, lastSwitchAt: Number.NEGATIVE_INFINITY };
+}
+
+/** Returns the tab id to activate, or null when the wheel event should not switch tabs. */
+export function resolveWheelTabTarget(input: {
+  state: TabWheelState;
+  deltaX: number;
+  deltaY: number;
+  now: number;
+  tabIds: string[];
+  activeTabId: string | null;
+}): string | null {
+  const { state, deltaX, deltaY, now, tabIds, activeTabId } = input;
+  const delta = Math.abs(deltaY) >= Math.abs(deltaX) ? deltaY : deltaX;
+  if (delta === 0 || tabIds.length < 2) return null;
+
+  // A direction change discards progress made in the other direction.
+  if (state.accumulated !== 0 && Math.sign(state.accumulated) !== Math.sign(delta)) {
+    state.accumulated = 0;
+  }
+  if (now - state.lastSwitchAt < TAB_WHEEL_COOLDOWN_MS) return null;
+
+  state.accumulated += delta;
+  if (Math.abs(state.accumulated) < TAB_WHEEL_DELTA_THRESHOLD) return null;
+
+  const direction = state.accumulated > 0 ? 1 : -1;
+  state.accumulated = 0;
+
+  const activeIndex = activeTabId === null ? -1 : tabIds.indexOf(activeTabId);
+  const nextIndex = activeIndex === -1 ? 0 : activeIndex + direction;
+  if (nextIndex < 0 || nextIndex >= tabIds.length) return null;
+
+  state.lastSwitchAt = now;
+  return tabIds[nextIndex] ?? null;
+}
