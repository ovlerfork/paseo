+    },
+    [displayedTabs, layout.requiresHorizontalScrollFallback, onNavigateTab],
+  );
+  const tabsWheelProps = useMemo(
+    () => (isWeb ? ({ onWheel: handleTabsWheel } as object) : undefined),
+    [handleTabsWheel],
+  );
+
