diff --git a/docker/mods/amp-acp/Dockerfile b/docker/mods/amp-acp/Dockerfile
new file mode 100644
index 0000000..d4e67c5
--- /dev/null
+++ b/docker/mods/amp-acp/Dockerfile
@@ -0,0 +1,25 @@
+# syntax=docker/dockerfile:1
+ARG BUSYBOX_IMAGE=busybox:1.37.0-uclibc
+ARG PASEO_MOD_NAME=amp-acp
+ARG PASEO_MOD_PACKAGE=amp-acp
+ARG PASEO_MOD_PACKAGE_VERSION=latest
+
+FROM ${BUSYBOX_IMAGE} AS meta
+ARG PASEO_MOD_NAME
+ARG PASEO_MOD_PACKAGE
+ARG PASEO_MOD_PACKAGE_VERSION
+RUN set -eu; \
+    install -d "/root-layer/etc/paseo-mods/${PASEO_MOD_NAME}"; \
+    printf '%s\n' "${PASEO_MOD_PACKAGE}" > "/root-layer/etc/paseo-mods/${PASEO_MOD_NAME}/package"; \
+    printf '%s\n' "${PASEO_MOD_PACKAGE_VERSION}" > "/root-layer/etc/paseo-mods/${PASEO_MOD_NAME}/package-version"
+
+FROM scratch
+ARG PASEO_MOD_NAME=amp-acp
+ARG PASEO_MOD_PACKAGE=amp-acp
+ARG PASEO_MOD_PACKAGE_VERSION=latest
+LABEL org.opencontainers.image.title="Paseo Docker Mod: ${PASEO_MOD_NAME}" \
+      org.ovlerfork.paseo.mod.name="${PASEO_MOD_NAME}" \
+      org.ovlerfork.paseo.mod.package="${PASEO_MOD_PACKAGE}" \
+      org.ovlerfork.paseo.mod.package.version="${PASEO_MOD_PACKAGE_VERSION}"
+COPY root-layer/ /
+COPY --from=meta /root-layer/ /
diff --git a/docker/mods/amp-acp/root-layer/etc/paseo-mods/amp-acp/install b/docker/mods/amp-acp/root-layer/etc/paseo-mods/amp-acp/install
new file mode 100755
index 0000000..0c46d7c
--- /dev/null
+++ b/docker/mods/amp-acp/root-layer/etc/paseo-mods/amp-acp/install
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if command -v amp-acp >/dev/null 2>&1; then
+  echo "[mod:amp-acp] amp-acp already on PATH; skipping install."
+  exit 0
+fi
+
+# amp-acp is only the ACP adapter. It drives the Amp CLI at runtime, so install
+# the Amp CLI first when it is missing or its launcher cannot run.
+if [[ -z "$(amp --version 2>/dev/null || true)" ]]; then
+  echo "[mod:amp-acp] installing @ampcode/cli with pnpm"
+  # The Amp CLI postinstall promotes the matching platform binary, so allow it
+  # even though pnpm skips dependency build scripts by default.
+  paseo-mod-install node --allow-build=@ampcode/cli @ampcode/cli
+fi
+
+package="amp-acp"
+version_file="/etc/paseo-mods/amp-acp/package-version"
+if [[ -r "$version_file" ]]; then
+  version="$(tr -d '[:space:]' < "$version_file")"
+  if [[ -n "$version" ]]; then
+    package="${package}@${version}"
+  fi
+fi
+
+echo "[mod:amp-acp] installing ${package} with pnpm"
+paseo-mod-install node "${package}"
+
+AMP_ACP_BIN="$(command -v amp-acp)" || {
+  echo "[mod:amp-acp] ERROR: ${package} did not install an 'amp-acp' binary on PATH." >&2
+  exit 1
+}
+AMP_BIN="$(command -v amp)" || {
+  echo "[mod:amp-acp] ERROR: the Amp CLI is not on PATH after install." >&2
+  exit 1
+}
+echo "[mod:amp-acp] done (${AMP_ACP_BIN}, ${AMP_BIN})"
