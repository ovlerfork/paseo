From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ovler <44089074+Ovler-Young@users.noreply.github.com>
Date: Thu, 10 Sep 2026 22:22:41 +0000
Subject: [PATCH] fix(docker): add oh-my-pi omp Docker mod


diff --git a/docker/mods/omp/Dockerfile b/docker/mods/omp/Dockerfile
new file mode 100644
index 0000000..85a95aa
--- /dev/null
+++ b/docker/mods/omp/Dockerfile
@@ -0,0 +1,25 @@
+# syntax=docker/dockerfile:1
+ARG BUSYBOX_IMAGE=busybox:1.37.0-uclibc
+ARG PASEO_MOD_NAME=omp
+ARG PASEO_MOD_PACKAGE=@oh-my-pi/pi-coding-agent
+ARG PASEO_MOD_PACKAGE_VERSION=latest
+
+FROM ${BUSYBOX_IMAGE} AS meta
+ARG PASEO_MOD_NAME
+ARG PASEO_MOD_PACKAGE
+ARG PASEO_MOD_PACKAGE_VERSION
+RUN set -eu; \
+    install -d "/root-layer/etc/paseo-mods/${PASEO_MOD_NAME}"; \
+    printf '%s\n' "${PASEO_MOD_PACKAGE}" > "/root-layer/etc/paseo-mods/${PASEO_MOD_NAME}/package"; \
+    printf '%s\n' "${PASEO_MOD_PACKAGE_VERSION}" > "/root-layer/etc/paseo-mods/${PASEO_MOD_NAME}/package-version"
+
+FROM scratch
+ARG PASEO_MOD_NAME=omp
+ARG PASEO_MOD_PACKAGE=@oh-my-pi/pi-coding-agent
+ARG PASEO_MOD_PACKAGE_VERSION=latest
+LABEL org.opencontainers.image.title="Paseo Docker Mod: ${PASEO_MOD_NAME}" \
+      org.ovlerfork.paseo.mod.name="${PASEO_MOD_NAME}" \
+      org.ovlerfork.paseo.mod.package="${PASEO_MOD_PACKAGE}" \
+      org.ovlerfork.paseo.mod.package.version="${PASEO_MOD_PACKAGE_VERSION}"
+COPY root-layer/ /
+COPY --from=meta /root-layer/ /
diff --git a/docker/mods/omp/root-layer/etc/paseo-mods/omp/install b/docker/mods/omp/root-layer/etc/paseo-mods/omp/install
new file mode 100755
index 0000000..61aff2d
--- /dev/null
+++ b/docker/mods/omp/root-layer/etc/paseo-mods/omp/install
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if command -v omp >/dev/null 2>&1; then
+  echo "[mod:omp] omp already on PATH; skipping install."
+  exit 0
+fi
+
+ensure_bun() {
+  local min_version="1.3.14" bun_version=""
+  if command -v bun >/dev/null 2>&1; then
+    bun_version="$(bun --version 2>/dev/null || true)"
+  fi
+  if [[ -n "$bun_version" ]] \
+    && printf '%s\n%s\n' "$min_version" "$bun_version" | sort -V -C 2>/dev/null; then
+    echo "[mod:omp] bun ${bun_version} already on PATH."
+    return 0
+  fi
+  if [[ -n "$bun_version" ]]; then
+    echo "[mod:omp] upgrading bun ${bun_version} (omp needs >= ${min_version})."
+  fi
+  echo "[mod:omp] installing the Bun runtime with pnpm"
+  # @oh-my-pi/pi-coding-agent ships as a Bun bundle, and the bun npm package
+  # replaces its placeholder bin with the real runtime in a postinstall script.
+  # pnpm skips dependency build scripts by default, so allow that one script.
+  paseo-mod-install node --allow-build=bun bun
+}
+
+ensure_bun
+
+package="@oh-my-pi/pi-coding-agent"
+version_file="/etc/paseo-mods/omp/package-version"
+if [[ -r "$version_file" ]]; then
+  version="$(tr -d '[:space:]' < "$version_file")"
+  if [[ -n "$version" ]]; then
+    package="${package}@${version}"
+  fi
+fi
+
+echo "[mod:omp] installing ${package} with pnpm"
+paseo-mod-install node --ignore-scripts "${package}"
+
+OMP_BIN="$(command -v omp)" || {
+  echo "[mod:omp] ERROR: ${package} did not install an 'omp' binary on PATH." >&2
+  exit 1
+}
+
+OMP_VERSION_OUTPUT="$(omp --version 2>&1)" || {
+  echo "[mod:omp] ERROR: 'omp --version' failed after installing ${package}:" >&2
+  echo "${OMP_VERSION_OUTPUT}" >&2
+  exit 1
+}
+echo "[mod:omp] done (${OMP_BIN}, ${OMP_VERSION_OUTPUT})"
diff --git a/docs/docker.md b/docs/docker.md
index 2acd203..cf64543 100644
--- a/docs/docker.md
+++ b/docs/docker.md
@@ -113,9 +113,9 @@ requires a key.
 
 ## Installing Agents
 
-The base image does not preinstall Claude Code, Codex, OpenCode, Copilot, Pi, or
-other agent CLIs. That keeps the default image small and avoids coupling Paseo
-releases to third-party agent release cycles.
+The base image does not preinstall Claude Code, Codex, OpenCode, Copilot, Pi,
+omp, or other agent CLIs. That keeps the default image small and avoids coupling
+Paseo releases to third-party agent release cycles.
 
 Use Docker Mods to install agent CLIs at container startup:
 
@@ -145,12 +145,17 @@ Available mod tags:
 | `copilot`     | `@github/copilot`                 | `copilot`  |
 | `opencode`    | `opencode-ai`                     | `opencode` |
 | `pi`          | `@earendil-works/pi-coding-agent` | `pi`       |
+| `omp`         | `@oh-my-pi/pi-coding-agent`       | `omp`      |
 
 Node-based mod hooks install global packages with `pnpm` first and fall back to
 `npm` only when `pnpm` is unavailable. Python-based mod hooks should use
 `paseo-mod-install python <package>`, which prefers `uv tool install` and falls
 back to `pipx`.
 
+The `omp` mod also installs the Bun runtime with
+`pnpm add -g --allow-build=bun bun`, because `@oh-my-pi/pi-coding-agent` ships
+as a Bun bundle.
+
 Codex is intentionally installed through the `codex` mod instead of baked into
 the base image, so a newly created container can pick up the current
 `@openai/codex` release without waiting for a new Paseo image.
